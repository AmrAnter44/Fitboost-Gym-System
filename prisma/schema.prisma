generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
  previewFeatures = []
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")

  // ⏱️ تحسين أداء SQLite للتعامل مع transactions الكبيرة
  relationMode = "prisma"
}

model Member {
  id                String       @id @default(cuid())
  memberNumber      String?      @unique
  name              String
  phone             String       // سيتم التحقق من التكرار في الـ API للأعضاء الجُدد
  backupPhone       String?
  email             String?
  nationalId        String?
  birthDate         DateTime?
  source            String?
  profileImage      String?
  idCardFront       String?
  idCardBack        String?
  inBodyScans       Int          @default(0)
  invitations       Int          @default(0)
  freePTSessions    Int          @default(0)
  freeNutritionSessions   Int    @default(0)
  freePhysioSessions      Int    @default(0)
  freeGroupClassSessions  Int    @default(0)
  freePoolSessions        Int    @default(0)
  freePadelSessions       Int    @default(0)
  freeAssessmentSessions  Int    @default(0)
  freeMoreSessions        Int    @default(0)
  remainingFreezeDays Int        @default(0)
  remainingCheckIns Int?         //  عدد الدخلات المتبقية — null = دخول غير محدود (اشتراك زمني عادي)
  subscriptionPrice Float
  remainingAmount   Float        @default(0)
  remainingDueDate  DateTime?
  points            Int          @default(0)
  notes             String?
  pushToken         String?      // Expo push notification token
  isActive          Boolean      @default(true)
  isFrozen          Boolean      @default(false)
  isBanned          Boolean      @default(false)
  startDate         DateTime?
  expiryDate        DateTime?
  // 🕐 ساعات الدخول المسموح بها (اختياري) - مثلاً "07:00" إلى "15:00"
  allowedCheckInStart String?    // HH:MM format
  allowedCheckInEnd   String?    // HH:MM format
  coachId           String?
  //  تاريخ آخر تعيين/تغيير كوتش — يستخدم لإشعار الكوتش بـ "عضو جديد اتأسند ليك"
  // حتى لو العضو نفسه قديم (re-assignment) لأن createdAt مش بيتغير
  coachAssignedAt   DateTime?
  //  ملاحظة الكوتش عن سبب عدم اشتراك العضو في PT بعد ما خلصت جلساته المجانية
  coachConversionNote String?
  coachConversionNoteAt DateTime?
  salesStaffId      String?
  offerId           String?      // 📦 الباقة اللي اشترك فيها العضو (للرجوع لمميزاتها)
  referrerMemberNumber String?   // 👥 رقم العضو اللي جاب العضو ده (لما المصدر = friend_referral)
  transferredFromMemberId String? // 📤 id العضو اللي نقل العضوية للعضو ده (نقل عضوية existing)
  transferredFromAt       DateTime? // 📤 تاريخ استلام النقل
  transferredFromPhone    String?   // 📤 الرقم القديم اللي اتنقلت منه العضوية (للـ timeline)
  createdAt         DateTime     @default(now())
  invitationRecords    Invitation[]
  receipts             Receipt[]
  checkIns             MemberCheckIn[]
  dayUses              DayUseInBody[]  @relation("MemberDayUses")
  spaBookings          SpaBooking[]
  freezeRequests       FreezeRequest[]
  pointsHistory        PointsHistory[]
  assessmentHistory    AssessmentHistory[]
  coach                Staff?       @relation("CoachMembers", fields: [coachId], references: [id], onDelete: SetNull)
  salesStaff           Staff?       @relation("SalesStaffMembers", fields: [salesStaffId], references: [id], onDelete: SetNull)

  // Free Session Relations
  ptSessions              PTSession[]
  nutritionSessions       NutritionSession[]
  physiotherapySessions   PhysiotherapySession[]
  groupClassSessions      GroupClassSession[]
  moreSessions            MoreSession[]
  moreSubscriptions       More[]

  @@index([coachId])
  @@index([salesStaffId])
  @@index([offerId])
  @@index([isActive])
  @@index([phone])
  @@index([expiryDate])
  @@index([createdAt])
}

model MemberCheckIn {
  id                    String    @id @default(cuid())
  memberId              String
  checkInTime           DateTime  @default(now())
  checkInMethod         String    @default("scan")

  member                Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([checkInTime])
}

model PT {
  ptNumber          Int         @id @default(autoincrement())
  clientName        String
  phone             String
  sessionsPurchased Int
  sessionsRemaining Int
  coachName         String
  pricePerSession   Float
  startDate         DateTime?
  expiryDate        DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  coachUserId       String?
  qrCode            String?     @unique
  qrCodeImage       String?
  remainingAmount   Int?
  // ❄️ Freeze fields (gated by SystemSettings.ptFreezeEnabled)
  isFrozen          Boolean     @default(false)
  freezeUntil       DateTime?
  sessions          PTSession[]
  receipts          Receipt[]
  contactLogs       PTContactLog[]

  @@index([coachUserId])
  @@index([qrCode])
}

// 📞 سجل المتابعات للحصص المخصصة (متابعات تجديد اشتراكات PT المنتهية أو القريبة من الانتهاء)
model PTContactLog {
  id           String    @id @default(cuid())
  ptNumber     Int
  activityType String    // 'call' | 'whatsapp' | 'visit' | 'note'
  result       String?   // 'no-answer' | 'busy' | 'agreed-renew' | 'rejected' | 'callback-later' | 'renewed'
  notes        String?
  nextContactAt DateTime?
  createdBy    String?
  createdAt    DateTime  @default(now())

  pt           PT        @relation(fields: [ptNumber], references: [ptNumber], onDelete: Cascade)
  staff        Staff?    @relation("PTContactLogs", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([ptNumber, createdAt])
}

model PTSession {
  id            String    @id @default(cuid())
  ptNumber      Int
  clientName    String
  coachName     String
  sessionDate   DateTime
  notes         String?
  createdAt     DateTime  @default(now())
  attended      Boolean   @default(false)
  attendedAt    DateTime?
  attendedBy    String?
  signature     String?
  pt            PT?       @relation(fields: [ptNumber], references: [ptNumber], onDelete: Cascade)

  // Free Session Tracking
  isFreeSession         Boolean   @default(false)
  memberId              String?
  member                Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  collectedInExpenseId  String?   // ID الـ Expense اللي اتحصلت فيه الجلسة المجانية

  @@index([ptNumber])
  @@index([sessionDate])
  @@index([attended])
  @@index([memberId])
  @@index([isFreeSession])
  @@index([collectedInExpenseId])
}

//  🏷️ أنواع الاستخدامات (يوم استخدام / مساج / تأجير لوكر…) — يديرها الأدمن بأسعار افتراضية
model DayUseService {
  id        String   @id @default(cuid())
  name      String   // اسم النوع المعروض (بيتخزّن في DayUseInBody.serviceType)
  price     Float    @default(0)   // السعر الافتراضي (قابل للتعديل وقت التسجيل)
  isBase    Boolean  @default(false) // النوع الأساسي (يوم استخدام) — مايتشلش
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model DayUseInBody {
  id           String    @id @default(cuid())
  name         String
  phone        String
  serviceType  String
  price        Float
  staffName    String
  salesStaffId String?
  memberId     String?   // 🔗 ربط يوم الاستخدام بعضو موجود (اختياري)
  createdAt    DateTime  @default(now())
  receipts     Receipt[]
  member       Member?   @relation("MemberDayUses", fields: [memberId], references: [id], onDelete: SetNull)

  @@index([salesStaffId])
  @@index([memberId])
}

model Visitor {
  id                   String     @id @default(cuid())
  name                 String
  phone                String     @unique
  notes                String?
  source               String     @default("walk-in")
  interestedIn         String?
  status               String     @default("pending")
  referrerMemberNumber String?    // 👥 رقم العضو اللي جاب الزائر (للـ tracking لما النقاط معطلة)
  isDeleted            Boolean    @default(false)
  deletedAt            DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  followUps            FollowUp[]

  @@index([status])
  @@index([createdAt])
  @@index([phone])
  @@index([isDeleted])
}

model FollowUp {
  id               String    @id @default(cuid())
  visitorId        String
  notes            String
  contacted        Boolean   @default(false)
  nextFollowUpDate DateTime?
  result           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  salesName        String?

  // New fields for enhanced tracking
  assignedTo       String?      // Staff ID assigned to this followup
  priority         String?      // 'high', 'medium', 'low'
  stage            String       @default("new") // Pipeline stage
  lastContactedAt  DateTime?    // Last contact timestamp
  contactCount     Int          @default(0)   // Number of contact attempts
  archived         Boolean      @default(false) // Soft delete for converted
  archivedAt       DateTime?    // When archived
  archivedReason   String?      // Why archived ('converted', 'renewed', 'manual')

  visitor          Visitor   @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  assignedStaff    Staff?    @relation("FollowUpAssignments", fields: [assignedTo], references: [id], onDelete: SetNull)
  activities       FollowUpActivity[]

  @@index([visitorId])
  @@index([nextFollowUpDate])
  @@index([contacted])
  @@index([assignedTo])
  @@index([stage])
  @@index([archived])
}

model Receipt {
  id            String        @id @default(cuid())
  receiptNumber Int           @unique
  type          String
  amount        Float
  itemDetails   String
  paymentMethod String        @default("cash")
  createdAt     DateTime      @default(now())
  staffName     String?
  memberId      String?
  ptNumber      Int?
  dayUseId      String?
  nutritionNumber    Int?
  physioNumber       Int?
  classNumber        Int?
  moreNumber         Int?
  isCancelled   Boolean       @default(false)
  cancelledAt   DateTime?
  cancelledBy   String?
  cancelReason  String?
  refundMethod  String?       // طريقة استرجاع الفلوس عند الإلغاء: 'cash' | 'instapay'
  dayUse        DayUseInBody? @relation(fields: [dayUseId], references: [id], onDelete: SetNull)
  pt            PT?           @relation(fields: [ptNumber], references: [ptNumber], onDelete: SetNull)
  member        Member?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  nutrition     Nutrition?    @relation(fields: [nutritionNumber], references: [nutritionNumber], onDelete: SetNull)
  physiotherapy Physiotherapy? @relation(fields: [physioNumber], references: [physioNumber], onDelete: SetNull)
  groupClass    GroupClass?   @relation(fields: [classNumber], references: [classNumber], onDelete: SetNull)
  more          More?         @relation(fields: [moreNumber], references: [moreNumber], onDelete: SetNull)

  @@index([createdAt])
  @@index([type])
  @@index([isCancelled])
  @@index([memberId])
  @@index([ptNumber])
  @@index([nutritionNumber])
  @@index([physioNumber])
  @@index([classNumber])
  @@index([moreNumber])
}

model ReceiptCounter {
  id      Int @id @default(autoincrement())
  current Int @default(0)
}

model MemberCounter {
  id      Int @id @default(autoincrement())
  current Int @default(1)
}

model Offer {
  id                      String   @id @default(cuid())
  name                    String
  duration                Int
  price                   Float
  minPrice                Float?   // 💰 الحد الأدنى لسعر الاشتراك بعد الخصم — يحدّه الأونر/الأدمن
  freePTSessions          Int      @default(0)
  freeNutritionSessions   Int      @default(0)
  freePhysioSessions      Int      @default(0)
  freeGroupClassSessions  Int      @default(0)
  freePoolSessions        Int      @default(0)
  freePadelSessions       Int      @default(0)
  freeAssessmentSessions  Int      @default(0)
  freeMoreSessions        Int      @default(0)
  nutritionPrice          Float?   @default(0)
  physioPrice             Float?   @default(0)
  groupClassPrice         Float?   @default(0)
  morePrice               Float?   @default(0)
  inBodyScans             Int      @default(0)
  invitations             Int      @default(0)
  freezeDays              Int      @default(0)
  maxCheckIns             Int      @default(0)    //  عدد حصص الدخول للباقة (0 = دخول غير محدود بالمدة)
  ptCommission            Float?   @default(0)   // عمولة الكوتش لهذه الباقة
  // 🕐 ساعات الدخول المسموح بها (اختياري) - مثل "07:00" إلى "15:00"
  allowedCheckInStart     String?  // HH:MM format
  allowedCheckInEnd       String?  // HH:MM format
  icon                    String   @default("📅")
  isActive                Boolean  @default(true)
  upgradeEligibilityDays  Int?     @default(7)
  upgradePoints           Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Staff {
  id           String         @id @default(cuid())
  staffCode    String         @unique
  name         String
  phone        String?
  position     String?        // Can store multiple positions as comma-separated (e.g., "مدرب,ريسبشن,بار")
  salary       Float?
  notes        String?
  workingHours Float?         // عدد ساعات العمل المطلوبة يومياً (e.g., 8)
  monthlyVacationDays Int?   // عدد أيام الإجازة شهرياً (e.g., 2)
  shiftStartTime String?     // ساعة بداية الشيفت (e.g., "09:00")
  shiftEndTime   String?     // ساعة نهاية الشيفت (e.g., "17:00")
  isActive     Boolean        @default(true)
  joinedDate   DateTime?      // تاريخ الانضمام — يُستخدم لحساب الراتب الـ pro-rated في الشهر الأول
  terminatedAt DateTime?      // تاريخ إنهاء الخدمة
  salesTarget          Float?   @default(0)   // التارجت الشهري بالجنيه لموظف السيلز
  salesCommissionType  String?               // 'fixed' | 'tiered'
  salesCommissionRate  Float?                // نسبة ثابتة (fixed mode)
  salesCommissionTiers String?               // JSON: [{target:5000,rate:3},{target:10000,rate:5}]
  coachTarget          Float?   @default(0)   //  التارجت الشهري بالجنيه للكوتش
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  attendance          Attendance[]
  expenses            Expense[]
  user                User?
  rotations           Rotation[]
  commissions         Commission[]
  members             Member[]       @relation("CoachMembers")
  salesMembers        Member[]       @relation("SalesStaffMembers")
  followUpAssignments FollowUp[]     @relation("FollowUpAssignments")
  followUpActivities  FollowUpActivity[]
  deductions          StaffDeduction[]
  whatsappAssignments WhatsAppConversation[] @relation("WhatsAppAssignments")
  bonuses             Bonus[]
  leaves              Leave[]
  shiftAssignments    ShiftAssignment[]
  payslips            Payslip[]
  salaryHistory       SalaryChangeLog[]
  ptContactLogs       PTContactLog[]   @relation("PTContactLogs")

  @@index([staffCode])
  @@index([isActive])
}

model StaffDeduction {
  id          String    @id @default(cuid())
  staffId     String
  staff       Staff     @relation(fields: [staffId], references: [id])
  amount      Float
  reason      String
  notes       String?
  isApplied   Boolean   @default(false)
  appliedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Attendance {
  id        String    @id @default(cuid())
  staffId   String
  checkIn   DateTime
  checkOut  DateTime?
  duration  Int?
  notes     String?
  selfieImage String?  //  مسار الصورة المخزّنة وقت السكان (anti buddy-punching)
  createdAt DateTime  @default(now())
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([checkIn])
}

model Expense {
  id          String   @id @default(cuid())
  type        String
  amount      Float
  description String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  staffId     String?
  isPaid      Boolean  @default(false)
  paidAmount  Float    @default(0)  // إجمالي المبلغ المسدّد فعلياً (للسلف اللي بتتخصم على أقساط)
  installmentLimit Float?           // الحد الأقصى للخصم الشهري (لو فاضي = خصم كامل عند الإمكان)
  paymentMethod String  @default("cash") //  cash | instapay | wallet — البنك اللي اتخصم منه المصروف
  category    String?           // تصنيف المصروف (اسم من ExpenseCategory) — يبقى نص عشان ميضيعش لو التصنيف اتمسح
  staff       Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([staffId])
  @@index([type])
  @@index([isPaid])
}

// تصنيفات المصاريف — يديرها المستخدم (إضافة/تعديل/حذف)
model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// ================================================================
// HR / Payroll Models
// ================================================================

// مكافآت شهرية يدوية
model Bonus {
  id        String   @id @default(cuid())
  staffId   String
  amount    Float
  reason    String
  month     Int      // 1-12
  year      Int
  notes     String?
  createdAt DateTime @default(now())
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, year, month])
}

// إجازات بـ date range — تحل محل monthlyVacationDays counter
model Leave {
  id        String   @id @default(cuid())
  staffId   String
  startDate DateTime
  endDate   DateTime
  type      String   // 'annual' | 'sick' | 'unpaid' | 'other'
  isPaid    Boolean  @default(true)
  reason    String?
  status    String   @default("approved") // 'pending' | 'approved' | 'rejected'
  createdAt DateTime @default(now())
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startDate])
}

// تعيين وردية ليوم محدد — يجوّز override للـ Rotation الأسبوعية
// مفيش unique constraint عشان نسمح بـ 2 shifts في اليوم (صباحي + مسائي)
model ShiftAssignment {
  id        String   @id @default(cuid())
  staffId   String
  date      DateTime // اليوم المحدد (تاريخ بدون وقت)
  startTime String   // "HH:MM"
  endTime   String   // "HH:MM"
  notes     String?
  createdAt DateTime @default(now())
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, date])
  @@index([date])
}

// snapshot الـ payroll لشهر معين — immutable history
model Payslip {
  id               String    @id @default(cuid())
  staffId          String
  month            Int
  year             Int
  baseSalary       Float
  totalBonuses     Float     @default(0)
  totalCommission  Float     @default(0)
  absenceDays      Int       @default(0)
  absenceDeduction Float     @default(0)
  lateMinutes      Int       @default(0)
  latePenalty      Float     @default(0)
  manualDeductions Float     @default(0)
  loansDeducted    Float     @default(0)
  netSalary        Float
  breakdown        String    // JSON snapshot لكل التفاصيل (items + amounts)
  paidAt           DateTime?
  paidBy           String?
  paymentMethod    String?   // 'cash' | 'bank_transfer' | 'instapay' | 'other'
  paymentNote      String?   // مرجع التحويل البنكي مثلاً
  voidedAt         DateTime?
  voidedBy         String?
  voidReason       String?
  createdAt        DateTime  @default(now())
  staff            Staff     @relation(fields: [staffId], references: [id])

  @@unique([staffId, year, month])
  @@index([year, month])
  @@index([voidedAt])
}

// تاريخ تغييرات الراتب — للـ audit
model SalaryChangeLog {
  id         String   @id @default(cuid())
  staffId    String
  oldSalary  Float?
  newSalary  Float?
  changedBy  String   // userId
  reason     String?
  createdAt  DateTime @default(now())
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, createdAt])
}

// أجازات رسمية / إجازات عامة (عيد، رأس السنة، إلخ) — تطبق على كل الموظفين النشطين
model Holiday {
  id        String   @id @default(cuid())
  date      DateTime
  name      String
  isPaid    Boolean  @default(true)
  recurring Boolean  @default(false) // لو متكرر سنوياً (نفس اليوم/الشهر)
  createdAt DateTime @default(now())

  @@unique([date])
  @@index([date])
}

model Commission {
  id          String   @id @default(cuid())
  staffId     String
  memberId    String?
  amount      Float
  type        String
  description String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([type])
  @@index([createdAt])
}

model Invitation {
  id         String   @id @default(cuid())
  guestName  String
  guestPhone String
  notes      String?
  createdAt  DateTime @default(now())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  password     String
  role         String        @default("STAFF")
  isActive     Boolean       @default(true)
  darkMode     Boolean       @default(false)  // 🌙 إعدادات Dark Mode
  locale       String        @default("ar")   // 🌐 إعدادات اللغة (ar/en)
  isSales      Boolean       @default(false)  // 🏷️ حساب سيلز - يشوف متابعاته بس
  profileImage String?       //  صورة بروفايل الموظف (يضيفها بنفسه)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  staffId      String?       @unique
  activityLogs ActivityLog[]
  permissions  Permission?
  spaBookings  SpaBooking[]
  staff        Staff?        @relation(fields: [staffId], references: [id])
}

model Permission {
  id                      String  @id @default(cuid())
  userId                  String  @unique
  canViewMembers          Boolean @default(false)
  canCreateMembers        Boolean @default(false)
  canEditMembers          Boolean @default(false)
  canDeleteMembers        Boolean @default(false)
  canViewPT               Boolean @default(false)
  canCreatePT             Boolean @default(false)
  canEditPT               Boolean @default(false)
  canDeletePT             Boolean @default(false)
  canRegisterPTAttendance Boolean @default(false)
  canViewNutrition        Boolean @default(false)
  canCreateNutrition      Boolean @default(false)
  canEditNutrition        Boolean @default(false)
  canDeleteNutrition      Boolean @default(false)
  canRegisterNutritionAttendance Boolean @default(false)
  canViewPhysiotherapy    Boolean @default(false)
  canCreatePhysiotherapy  Boolean @default(false)
  canEditPhysiotherapy    Boolean @default(false)
  canDeletePhysiotherapy  Boolean @default(false)
  canRegisterPhysioAttendance Boolean @default(false)
  canViewGroupClass       Boolean @default(false)
  canCreateGroupClass     Boolean @default(false)
  canEditGroupClass       Boolean @default(false)
  canDeleteGroupClass     Boolean @default(false)
