  name          String
  serviceType   String   // 'PT', 'Nutrition', 'Physiotherapy', 'GroupClass', 'More'
  sessions      Int
  price         Float
  durationDays  Int      @default(30)  // 📅 مدة الاشتراك بالأيام (افتراضي: 30 يوم)
  moreCommission Float?  @default(0)  // 💰 عمولة المدرب لباقات مزيد (0 = استخدام الإعدادات الافتراضية)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([serviceType])
  @@index([isActive])
}

// نظام النقاط - تاريخ اكتساب النقاط
model PointsHistory {
  id          String   @id @default(cuid())
  memberId    String
  points      Int      // عدد النقاط المكتسبة
  action      String   // نوع النشاط: 'check-in', 'invitation'
  description String?  // وصف اختياري
  createdAt   DateTime @default(now())

  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([createdAt])
  @@index([action])
}

// نظام التقييمات - تاريخ التقييمات البدنية
model AssessmentHistory {
  id          String   @id @default(cuid())
  memberId    String
  type        String   // نوع التقييم: 'weight', 'body_fat', 'muscle_mass', 'manual', etc
  value       Float?   // القيمة (وزن، نسبة دهون، إلخ)
  notes       String?  // ملاحظات أو سبب التقييم
  createdAt   DateTime @default(now())

  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([createdAt])
  @@index([type])
}

// جدول مواعيد الجروب كلاسيس الأسبوعية
model ClassSchedule {
  id          String   @id @default(cuid())
  dayOfWeek   Int      // 0=الأحد, 1=الاثنين, 2=الثلاثاء, 3=الأربعاء, 4=الخميس, 5=الجمعة, 6=السبت
  startTime   String   // "HH:mm" e.g. "09:00"
  className   String   // نوع الكلاس e.g. "زومبا", "يوجا", "كروسفيت"
  coachName   String   // اسم الكوتش
  duration    Int      @default(60) // المدة بالدقائق
  gender      String   @default("mixed") // "male" رجالي | "female" نسائي | "mixed" مختلط
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dayOfWeek])
  @@index([isActive])
}

// قائمة المحظورين
model BannedMember {
  id         String   @id @default(cuid())
  name       String?
  phone      String?
  nationalId String?
  reason     String?
  notes      String?
  bannedBy   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([phone])
  @@index([nationalId])
}

// حجوزات كلاسات اليوم
model ClassBooking {
  id              String   @id @default(cuid())
  memberId        String
  classScheduleId String   // أي كلاس محجوز
  bookingDate     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([memberId])
  @@index([bookingDate])
  @@index([classScheduleId])
  @@unique([memberId, classScheduleId, bookingDate])
}

// نظام الترخيص من Supabase
model SupabaseLicense {
  id                  String   @id @default(cuid())
  gymId               String
  gymName             String
  branchId            String
  branchName          String
  systemLicense       String   // 'true', 'false', 'active'
  licenseMessage      String?
  offlineModeEnabled  Boolean  @default(false)
  lastChecked         DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([branchId])
}

// تتبع الـ leads اللي اتجابت من ويبسايت الجيم (website_leads على Supabase)
// عشان لما نـpoll نعرف اللي اتجاب فعلاً ومانعمل visitors duplicate
model WebsiteLeadImport {
  id          String   @id @default(cuid())
  remoteId    String   @unique  // UUID from Supabase website_leads.id
  visitorId   String?            // الـ Visitor المحلي اللي اتعمل
  importedAt  DateTime @default(now())

  @@index([remoteId])
}

// قائمة الانتظار لمزامنة الإيصالات والمصروفات مع Supabase
// (لما الإنترنت يقطع، البيانات تتراكم هنا وتتبعت لما يرجع)
model SyncQueueItem {
  id           String    @id @default(cuid())
  resource     String    // 'receipt' | 'expense'
  operation    String    // 'upsert' | 'delete'
  resourceId   String    // local id (Receipt.id / Expense.id)
  payload      String    // JSON snapshot of the row
  attempts     Int       @default(0)
  lastError    String?
  status       String    @default("pending")  // pending | sent | failed
  createdAt    DateTime  @default(now())
  sentAt       DateTime?

  @@index([status])
  @@index([resource])
  @@index([createdAt])
}

// قوالب رسائل الواتساب
model WhatsAppTemplate {
  id        String   @id @default(cuid())
  title     String
  icon      String   @default("💬")
  message   String
  isCustom  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== WhatsApp Multi-Number Inbox System =====

model WhatsAppSession {
  id                String    @id @default(cuid())
  sessionIndex      Int       @unique
  label             String
  phoneNumber       String?
  status            String    @default("disconnected")
  isActive          Boolean   @default(true)
  warmupComplete    Boolean   @default(false)
  warmupStartedAt   DateTime?
  dailyMessageCount Int       @default(0)
  dailyCountResetAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  conversations WhatsAppConversation[]
  messages      WhatsAppMessage[]
  queueItems    WhatsAppQueueItem[]

  @@index([sessionIndex])
  @@index([status])
  @@index([isActive])
}

model WhatsAppConversation {
  id              String    @id @default(cuid())
  remotePhone     String    @unique
  remoteName      String?
  lastMessageAt   DateTime?
  lastMessageText String?
  status          String    @default("open")
  assignedToId    String?
  sessionId       String?
  unreadCount     Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  session    WhatsAppSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  assignedTo Staff?           @relation("WhatsAppAssignments", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   WhatsAppMessage[]

  @@index([status])
  @@index([assignedToId])
  @@index([lastMessageAt])
  @@index([sessionId])
}

model WhatsAppMessage {
  id             String    @id @default(cuid())
  conversationId String
  sessionId      String?
  direction      String
  messageType    String    @default("text")
  content        String
  mediaUrl       String?
  whatsappMsgId  String?
  status         String    @default("pending")
  sentById       String?
  createdAt      DateTime  @default(now())

  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  session      WhatsAppSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([sessionId])
  @@index([createdAt])
  @@index([direction])
  @@index([status])
}

model WhatsAppQueueItem {
  id          String    @id @default(cuid())
  sessionId   String
  phone       String
  messageType String    @default("text")
  content     String
  mediaBase64 String?
  priority    Int       @default(5)
  status      String    @default("queued")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  error       String?
  createdById String?
  createdAt   DateTime  @default(now())

  session WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([status])
  @@index([scheduledAt])
  @@index([priority])
}

//  المتعلقات المفقودة — Lost & Found
model LostAndFound {
  id          String   @id @default(cuid())
  itemName    String                        // وصف الحاجة المفقودة
  category    String   @default("A")         // الفئة: A / B / C
  location    String?                        // مكان اللقيا (مثال: فلور على تريدميل)
  foundByType String   @default("staff")     // مين لاقاها: staff | member
  foundByName String?                        // اسم اللي لاقاها
  status      String   @default("stored")    // stored (محفوظة) | returned (اتسلمت)
  claimedBy   String?                        // اتسلمت لمين
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([createdAt])
}

//  الإيميل الداخلي — الأدمن يبعت رسالة لقسم (كباتن / ريسبشن / الاتنين)
model InternalMessage {
  id          String   @id @default(cuid())
  senderId    String                         // User.id بتاع الأدمن
  senderName  String                         // snapshot لاسم المُرسِل
  subject     String
  body        String
  targetDepts String                         // الأقسام المستهدفة "coaches,reception"
  createdAt   DateTime @default(now())

  recipients  InternalMessageRecipient[]
  replies     InternalMessageReply[]

  @@index([senderId])
  @@index([createdAt])
}

//  رد الموظف على الرسالة الداخلية
model InternalMessageReply {
  id        String   @id @default(cuid())
  messageId String
  userId    String                          // User.id بتاع الراد
  userName  String                          // snapshot لاسم الراد
  body      String
  createdAt DateTime @default(now())

  message   InternalMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

//  نسخة الرسالة لكل مستقبِل (عشان حالة القراءة تبقى لكل شخص لوحده)
model InternalMessageRecipient {
  id         String    @id @default(cuid())
  messageId  String
  userId     String                          // User.id بتاع الكوتش/الموظف
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  message    InternalMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([messageId])
}

//  قسم الشكاوى — شكوى مربوطة بعضو معيّن
model Complaint {
  id           String   @id @default(cuid())
  memberId     String                         // العضو اللي الشكوى تبعه
  memberName   String                         // snapshot
  memberNumber String?
  memberPhone  String?
  subject      String?                        // عنوان مختصر (اختياري)
  body         String                         // نص الشكوى
  status       String   @default("open")      // open (مفتوحة) | resolved (اتحلّت)
  priority     String   @default("normal")    // low | normal | high
  resolution   String?                        // رد/حل الشكوى — ده اللي العضو بيشوفه كردّ في التطبيق
  source       String   @default("staff")      // staff (سجّلها موظف) | app (العضو بعتها من التطبيق)
  createdBy    String?                         // اسم الموظف اللي سجّلها
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([memberId])
  @@index([status])
  @@index([createdAt])
}

//  صيانة الأجهزة — متابعة أعطال وإصلاحات الأجهزة وتكلفتها
model MaintenanceRecord {
  id          String    @id @default(cuid())
  deviceName  String                         // اسم الجهاز (تريدميل، دراجة، ...)
  issue       String                         // العطل / وصف المشكلة
  cost        Float     @default(0)          // تكلفة الإصلاح
  status      String    @default("fixed")    // reported (بلاغ مفتوح) | fixed (اتصلح)
  fixedAt     DateTime?                        // تاريخ الإصلاح
  notes       String?
  createdBy   String?                          // اسم الموظف
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deviceName])
  @@index([status])
  @@index([createdAt])
}

//  المهام (To-Do) — الأدمن يدّي الموظفين تاسك بـ deadline ويتابع الإنجاز
model Task {
  id            String    @id @default(cuid())
  title         String
  description   String?
  dueDate       DateTime?
  priority      String    @default("normal")   // low | normal | high
  createdBy     String                          // User.id بتاع الأدمن
  createdByName String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignments   TaskAssignment[]

  @@index([createdBy])
  @@index([dueDate])
  @@index([createdAt])
}

//  إسناد المهمة لموظف (لكل موظف حالته لوحده)
model TaskAssignment {
  id          String    @id @default(cuid())
  taskId      String
  userId      String                            // الموظف المسنَدة له
  status      String    @default("pending")     // pending | done
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([taskId])
}
