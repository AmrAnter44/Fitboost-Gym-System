// 🐛 Error Tracking System
model ErrorLog {
  id                String    @id @default(cuid())

  // معلومات الخطأ
  errorType         String    // FRONTEND, BACKEND_API, DATABASE, AUTHENTICATION, UNKNOWN
  errorCategory     String?   // PRISMA_ERROR, VALIDATION_ERROR, NETWORK_ERROR, JWT_ERROR, etc.
  severity          String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL

  // رسائل الخطأ
  message           String
  sanitizedMessage  String?
  errorCode         String?
  stackTrace        String?

  // السياق
  endpoint          String?
  httpMethod        String?
  statusCode        Int?

  // المستخدم
  userId            String?
  userEmail         String?
  userName          String?
  userRole          String?
  staffId           String?

  // الطلب
  requestBody       String?   // JSON string
  requestHeaders    String?   // JSON string
  ipAddress         String?
  userAgent         String?

  // إضافي
  additionalContext String?   // JSON string
  browserInfo       String?   // JSON string

  // النظام
  environment       String    @default("production")
  appVersion        String?

  // التوقيت
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?
  isResolved        Boolean   @default(false)

  // Sync مع Supabase
  syncedToSupabase  Boolean   @default(false)
  supabaseId        String?   // UUID from Supabase
  syncAttempts      Int       @default(0)
  lastSyncAttempt   DateTime?

  @@index([errorType])
  @@index([severity])
  @@index([createdAt])
  @@index([endpoint])
  @@index([userId])
  @@index([isResolved])
  @@index([syncedToSupabase])
  @@index([errorCategory])
}

// 💆 SPA Booking System
model SpaBooking {
  id              String    @id @default(cuid())

  // معلومات العضو
  memberId        String
  memberName      String
  memberPhone     String?

  // معلومات الحجز
  serviceType     String    // 'massage', 'sauna', 'jacuzzi'
  bookingDate     DateTime  // تاريخ الحجز
  bookingTime     String    // وقت البدء "10:00"
  duration        Int       // المدة بالدقائق (30, 60, 90)

  // الحالة
  status          String    @default("pending")  // pending, confirmed, completed, cancelled

  // ملاحظات
  notes           String?

  // من قام بالحجز
  createdBy       String    // اسم الموظف/المدير
  createdByUserId String?   // ID المستخدم (اختياري)

  // التواريخ
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // العلاقات
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  user            User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([memberId])
  @@index([bookingDate])
  @@index([status])
  @@index([serviceType])
}

model FreezeRequest {
