# =====================================================================
# FitBoost — متغيرات البيئة لسيرفر جيم حقيقي
# بيتولّد تلقائياً في <APP_DIR>/.env وقت التنصيب (setup-gym.sh)
# ⚠️ الملف ده فيه أسرار — صلاحياته 600 ومايتحطّش في git أبداً
# =====================================================================

# ── هوية النسخة ──────────────────────────────────────────────────────
# لازم تكون مختلفة لكل جيم على نفس السيرفر: اسم عمليات PM2 والبورتات
# ومجلد جلسات الواتساب. الافتراضي (fitboost/4001/4002) هو اللي بيستخدمه
# الديمو ونسخة الديسكتوب.
APP_NAME=fitboost-gym
PORT=4011
WHATSAPP_PORT=4012
WHATSAPP_AUTH_DIR=/opt/fitboost-gym/.whatsapp-auth

# ── الداتابيز ────────────────────────────────────────────────────────
# اسم الملف حر — التطبيق بيشتقه من DATABASE_URL عن طريق lib/dbPath.ts،
# فسمّيه باسم الجيم عشان ماتلخبطش بين داتابيزات جيمات مختلفة.
DATABASE_URL="file:/opt/fitboost-gym/prisma/helmyapoint.db?connection_limit=5&pool_timeout=30&journal_mode=WAL&busy_timeout=10000"

# ── أسرار ────────────────────────────────────────────────────────────
# سر توقيع الجلسات — بيتولّد عشوائي وقت التنصيب
JWT_SECRET="REPLACE_ME_WITH_RANDOM_128_HEX_CHARS"

# سر التخاطب بين خدمة الواتساب والتطبيق (lib/internalAuth.ts).
# من غيره كل مسارات /api/whatsapp/internal بترجّع 503 والواتساب مابيشتغلش.
INTERNAL_API_TOKEN="REPLACE_ME_WITH_RANDOM_64_HEX_CHARS"

NODE_ENV=production
HOSTNAME=127.0.0.1

NEXT_PUBLIC_APP_URL="https://gym.example.com"
NEXT_PUBLIC_WEBSITE_URL="https://gym.example.com"
NEXT_TELEMETRY_DISABLED=1

# مسار رفع الصور — خارج مجلد الكود عشان التحديثات ماتمسحوش.
# ⚠️ بيتقرا وقت الـ build (next.config rewrites) مش وقت التشغيل، فلازم
#    الملف ده يكون موجود قبل `npm run build`.
UPLOADS_PATH=/opt/fitboost-gym/uploads

# ---------------------------------------------------------------------
# اختيارية — سيبها فاضية لو مش مستخدمة:
#   SUPABASE_*  الترخيص/المزامنة (مفيش سجل license = النظام شغال عادي)
#   B2_*        النسخ الاحتياطي السحابي (Backblaze) من الإعدادات
#   GH_TOKEN    التحديث التلقائي — خاص بنسخة الديسكتوب، ملهوش لازمة هنا
#   OWNER_*     حساب طوارئ بيتحقق من الـ env مش من الداتابيز. سايبينه
#               فاضي عن قصد: حساب الأونر الحقيقي في الداتابيز. فعّله
#               مؤقتاً بس لو اتقفل عليك الدخول.
# ---------------------------------------------------------------------
