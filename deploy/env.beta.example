# =====================================================================
# FitBoost Beta — متغيرات البيئة لسيرفر النسخة التجريبية
# انسخه لـ /opt/fitboost-beta/.env وعدّل القيم
# ⚠️ لا تستخدم مفاتيح الإنتاج الحقيقية هنا — دي نسخة عامة على الإنترنت
# =====================================================================

# قاعدة البيانات التجريبية (نفس اسم gym.db عشان كل سكربتات الصيانة تشتغل عادي)
DATABASE_URL="file:/opt/fitboost-beta/prisma/gym.db?connection_limit=5&pool_timeout=30&journal_mode=WAL&busy_timeout=10000"

# سر التوقيع — يتولّد عشوائي وقت التنصيب (64 بايت hex)
JWT_SECRET="REPLACE_ME_WITH_RANDOM_128_HEX_CHARS"

NODE_ENV=production
PORT=4001
HOSTNAME=127.0.0.1

# الدومين العام للبيتا
NEXT_PUBLIC_APP_URL="https://beta.example.com"
NEXT_PUBLIC_WEBSITE_URL="https://beta.example.com"
NEXT_TELEMETRY_DISABLED=1

# مسار رفع الصور (لازم يكون قابل للكتابة وخارج مجلد الكود)
UPLOADS_PATH=/opt/fitboost-beta/uploads

# ---------------------------------------------------------------------
# متروكة فاضية عن قصد في البيتا:
#   SUPABASE_*  -> الترخيص/المزامنة السحابية (مفيش سجل license = النظام شغال)
#   B2_*        -> النسخ الاحتياطي السحابي
#   GH_TOKEN    -> التحديث التلقائي (خاص بنسخة الديسكتوب)
#   OWNER_*     -> الحساب الاحتياطي؛ حساب الأونر التجريبي موجود في الداتابيز
# ---------------------------------------------------------------------
